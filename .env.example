# Mana Forge — every setting the site reads. Copy to .env (local) or paste into your hosting
# platform's "Environment variables" section (production). Never commit the real .env.
# Values marked (required) must be set in production or that part of the site breaks.

# ---- Database --------------------------------------------------------------------------------
# On the server: DATABASE_PATH=/data/manaforge.db (persistent volume); locally leave it unset.
DATABASE_URL="file:./dev.db"                 # (required) SQLite file; on the server use a persistent volume

# ---- Sign-in (Auth.js) -----------------------------------------------------------------------
AUTH_SECRET=""                               # (required) long random string: npx auth secret
AUTH_TRUST_HOST=true                         # (required behind a reverse proxy such as Coolify/Traefik)
TRUST_CLOUDFLARE=0                           # set to 1 only once Cloudflare proxies the site (orange cloud)

# ---- Site identity ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME="Mana Forge"
NEXT_PUBLIC_SITE_URL="https://manaforgehub.com"   # (required) used in links, sitemap, share previews, Stripe redirects
NEXT_PUBLIC_SITE_TAGLINE="Magic: The Gathering decks, tools & gear"
NEXT_PUBLIC_SITE_TWITTER=""                  # optional @handle
APP_URL=""                                   # optional; overrides NEXT_PUBLIC_SITE_URL for Stripe redirects

# ---- Shop switch -----------------------------------------------------------------------------
NEXT_PUBLIC_SHOP_ENABLED=0                   # 1 = store + proxies open, 0 = "coming soon" (Premium unaffected)
NEXT_PUBLIC_ADS_ENABLED=0                    # 1 = AdSense ads in the ad slots (never for Premium); build variable
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=             # AdSense ad unit ID for the wide slots
NEXT_PUBLIC_ADSENSE_SLOT_SQUARE=             # AdSense ad unit ID for the square slots
RESEND_API_KEY=                              # sends password resets, welcome and contact alerts (runtime only)

# ---- Payments (Stripe) -----------------------------------------------------------------------
STRIPE_SECRET_KEY=""                         # sk_live_… in production, sk_test_… locally
STRIPE_WEBHOOK_SECRET=""                     # whsec_… from the webhook endpoint /api/webhooks/stripe

# ---- Legal pages (shown in Impressum / Privacy / Terms) --------------------------------------
LEGAL_OWNER=""                               # your full name or company
LEGAL_ADDRESS=""                             # street, postcode, city, country
LEGAL_EMAIL=""
LEGAL_COUNTRY="Germany"

# ---- Optional --------------------------------------------------------------------------------
SCRYFALL_API_URL=""                          # leave empty to use https://api.scryfall.com
